# Copy to .env and fill in real values. Never commit .env.

# Google OAuth 2.0 client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# HS256 signing key, at least 256 bits (32+ characters). Generate: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Allowed CORS origin(s), comma separated
FRONTEND_URL=http://localhost:3000

# Only for the prod profile (SPRING_PROFILES_ACTIVE=prod)
# DB_URL=jdbc:postgresql://localhost:5432/users
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
